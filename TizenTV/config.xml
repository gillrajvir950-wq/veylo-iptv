<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://veylo.app/tv" version="0.1.2" viewmodes="maximized">
    <tizen:application id="VeyloIPTV1.Veylo" package="VeyloIPTV1" required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <icon src="icon.png"/>
    <name>Veylo</name>
    <description>Veylo — live TV player for streams you are authorized to access.</description>
    <access origin="*" subdomains="true"/>
